{
  "name": "rumi-build",
  "version": "1.2.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "precheck": "! grep -rn 'REPLACE_ME' src/ || (echo 'ERROR: Replace placeholder Stripe URL before deploy' && exit 1)",
    "build": "pnpm precheck && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.4.0",
    "@vercel/analytics": "^1.4.1",
    "geist": "^1.3.1",
    "google-auth-library": "^10.6.2",
    "next": "^15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.1.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
